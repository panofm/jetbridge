{
  "name": "jetbridge",
  "version": "0.1.0-rc.1",
  "description": "Build, sign and deliver iOS dev builds \u2014 to a simulator, down a cable, or over the air to your own bucket.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "jetbridge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/v1.json"
  },
  "files": [
    "dist",
    "schema",
    "templates"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panofm/jetbridge.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "schema": "bun scripts/generate-schema.mjs",
    "check:schema": "bun scripts/generate-schema.mjs --check",
    "prepack": "cp ../../README.md README.md && bun run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.984.0",
    "@clack/prompts": "^1.0.1",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "dotenv": "^17.4.2",
    "execa": "^9.5.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "ios",
    "xcode",
    "xcodebuild",
    "install",
    "ota",
    "ad-hoc",
    "itms-services",
    "testflight",
    "simulator",
    "devicectl"
  ]
}
